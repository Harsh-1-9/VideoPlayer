<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer gold ring -->
    <path
        android:pathData="M54,8 A46,46 0 1,1 53.999,8 Z"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:strokeColor="#FFD4A843" />

    <!-- Inner subtle ring -->
    <path
        android:pathData="M54,16 A38,38 0 1,1 53.999,16 Z"
        android:strokeWidth="1"
        android:fillColor="#00000000"
        android:strokeColor="#66D4A843" />

    <!-- Gold play triangle -->
    <path
        android:pathData="M44,36 L44,72 L76,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                xmlns:gradient="http://schemas.android.com/apk/res/android"
                android:type="linear"
                android:startX="44"
                android:startY="36"
                android:endX="76"
                android:endY="72">
                <item android:offset="0" android:color="#FFEFC96B" />
                <item android:offset="0.5" android:color="#FFD4A843" />
                <item android:offset="1" android:color="#FFB8860B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Small accent dot at top of ring -->
    <path
        android:pathData="M54,10 A2,2 0 1,1 53.999,10 Z"
        android:fillColor="#FFD4A843" />
</vector>
