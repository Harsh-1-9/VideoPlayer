<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Luxury Gold Ring -->
    <path
        android:pathData="M54,18 A36,36 0 1,1 53.999,18 Z"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:strokeColor="#FFD4A843" />

    <!-- Thin Decorative Inner Ring -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.999,26 Z"
        android:strokeWidth="1.2"
        android:fillColor="#00000000"
        android:strokeColor="#55D4A843" />

    <!-- Gold Play Triangle with Gradient -->
    <path
        android:pathData="M46,38 L46,70 L72,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="46"
                android:startY="38"
                android:endX="72"
                android:endY="70">
                <item android:offset="0.0" android:color="#FFEFC96B" />
                <item android:offset="0.5" android:color="#FFD4A843" />
                <item android:offset="1.0" android:color="#FFB8860B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
